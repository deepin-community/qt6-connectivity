Author: Tian Shilin <tianshilin@uniontech.com>
Date:   Tue Jun 09 14:21:42 2026
Subject: QNdefNfcTextRecord: fix out-of-bounds read in locale() and text()
Upstream: https://codereview.qt-project.org/c/qt/qtconnectivity/+/746284


---

Index: qt6-connectivity/src/nfc/qndefnfctextrecord.cpp
===================================================================
--- qt6-connectivity.orig/src/nfc/qndefnfctextrecord.cpp
+++ qt6-connectivity/src/nfc/qndefnfctextrecord.cpp
@@ -54,6 +54,9 @@ QString QNdefNfcTextRecord::locale() con
 
     quint8 codeLength = status & 0x3f;
 
+    if (p.size() < 1 + codeLength)
+        return QString();
+
     return QString::fromLatin1(p.constData() + 1, codeLength);
 }
 
@@ -90,6 +93,9 @@ QString QNdefNfcTextRecord::text() const
     bool utf16 = status & 0x80;
     quint8 codeLength = status & 0x3f;
 
+    if (p.size() < 1 + codeLength)
+        return QString();
+
     auto toUnicode = QStringDecoder(
         utf16 ? QStringDecoder::Encoding::Utf16BE : QStringDecoder::Encoding::Utf8,
         QStringDecoder::Flag::Stateless);
